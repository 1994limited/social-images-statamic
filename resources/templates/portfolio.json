{
  "schema": "social-images/1",
  "title": "Portfolio",
  "description": "The photo, full size, with a small white caption card. For photography, art and design work.",
  "layouts": {
    "og": {
      "width": 1200,
      "height": 630,
      "background": {
        "type": "solid",
        "color": "#e5e5e5"
      },
      "layers": [
        {
          "id": "photo",
          "name": "Photo",
          "type": "image",
          "source": [
            "field:featured_image",
            "field:image",
            "field:hero_image",
            "field:cover_image",
