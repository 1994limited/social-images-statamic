          "x": 72,
          "y": 80,
          "width": 560,
          "height": 40,
          "font": {
            "family": "Manrope",
            "weight": 800,
            "style": "normal"
          },
          "size": 18,
          "min_size": 14,
          "color": "#92400e",
          "hug": true,
          "background": {
            "type": "solid",
            "color": "#ffffff"
          },
          "padding": [
            8,
            16,
            8,
            16
          ],
          "radius": 999,
          "transform": "uppercase",
          "letter_spacing": 0.08,
          "balance": false
        },
        {
          "id": "title",
          "name": "Name",
          "type": "text",
          "text": "{title}",
          "x": 72,
          "y": 140,
          "width": 580,
