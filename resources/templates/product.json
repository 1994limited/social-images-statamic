{
  "schema": "social-images/1",
  "title": "Product",
  "description": "The product’s picture on a sunny blob, its name and its price (from a price field, if it has one). For shops.",
  "layouts": {
    "og": {
      "width": 1200,
      "height": 630,
      "background": {
        "type": "linear",
        "angle": 120,
        "stops": [
          {
            "color": "#fef3c7",
            "position": 0
          },
          {
            "color": "#fde68a",
            "position": 100
          }
        ]
      },
      "layers": [
        {
          "id": "blob",
          "name": "Blob",
          "type": "shape",
          "x": 660,
          "y": 65,
          "width": 500,
          "height": 500,
          "fill": {
            "type": "solid",
            "color": "#fbbf24"
          },
          "shape": "ellipse",
          "opacity": 0.5
        },
        {
          "id": "photo",
          "name": "Product",
          "type": "image",
          "source": [
            "field:featured_image",
            "field:image",
            "field:hero_image",
            "field:cover_image",
            "field:photo",
            "field:thumbnail"
          ],
          "x": 690,
          "y": 70,
          "width": 440,
          "height": 490,
          "fit": "contain"
        },
        {
          "id": "label",
          "name": "Label",
