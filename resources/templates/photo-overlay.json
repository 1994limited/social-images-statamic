{
  "schema": "social-images/1",
  "title": "Photo overlay",
  "description": "The entry’s photo fills the image, darkened at the bottom under a white title.",
  "layouts": {
    "og": {
      "width": 1200,
      "height": 630,
      "background": {
        "type": "solid",
        "color": "#111827"
      },
      "layers": [
        {
          "id": "photo",
          "name": "Photo",
          "type": "image",
          "source": [
            "field:featured_image",
            "field:image",
            "field:hero_image",
            "field:cover_image",
            "field:photo",
            "field:thumbnail"
          ],
          "x": 0,
          "y": 0,
          "width": 1200,
          "height": 630,
          "fit": "cover"
        },
        {
          "id": "shade",
          "name": "Shade",
          "type": "shape",
          "x": 0,
          "y": 0,
          "width": 1200,
          "height": 630,
          "fill": {
            "type": "linear",
            "angle": 180,
            "stops": [
              {
                "color": "#00000000",
                "position": 30
              },
              {
                "color": "#000000d9",
                "position": 100
              }
            ]
          }
        },
        {
          "id": "label",
          "name": "Label",
          "type": "text",
          "text": "{collection:title}",
          "x": 72,
          "y": 330,
          "width": 800,
          "height": 44,
          "font": {
            "family": "DM Sans",
            "weight": 700,
            "style": "normal"
          },
          "size": 20,
          "min_size": 14,
          "color": "#111827",
          "hug": true,
          "padding": [
            8,
            16,
            8,
            16
          ],
          "radius": 6,
          "background": {
            "type": "solid",
            "color": "#facc15"
          },
          "transform": "uppercase",
          "letter_spacing": 0.08,
          "balance": false
        },
        {
          "id": "title",
          "name": "Title",
          "type": "text",
          "text": "{title}",
          "x": 72,
          "y": 390,
          "width": 1056,
          "height": 180,
          "font": {
            "family": "DM Sans",
            "weight": 700,
            "style": "normal"
          },
          "size": 64,
          "min_size": 32,
          "color": "#ffffff",
          "valign": "bottom",
          "line_height": 1.08,
          "letter_spacing": -0.02,
          "max_lines": 3
        }
      ]
    },
    "square": {
      "width": 1080,
      "height": 1080,
      "background": {
        "type": "solid",
        "color": "#111827"
      },
      "layers": [
        {
          "id": "photo",
          "name": "Photo",
          "type": "image",
          "source": [
            "field:featured_image",
            "field:image",
            "field:hero_image",
            "field:cover_image",
            "field:photo",
            "field:thumbnail"
          ],
          "x": 0,
          "y": 0,
          "width": 1080,
          "height": 1080,
          "fit": "cover"
        },
        {
          "id": "shade",
          "name": "Shade",
          "type": "shape",
          "x": 0,
          "y": 0,
          "width": 1080,
          "height": 1080,
          "fill": {
            "type": "linear",
            "angle": 180,
            "stops": [
              {
                "color": "#00000000",
                "position": 35
              },
              {
                "color": "#000000d9",
                "position": 100
              }
            ]
          }
        },
        {
          "id": "label",
          "name": "Label",
          "type": "text",
          "text": "{collection:title}",
          "x": 72,
          "y": 690,
          "width": 800,
          "height": 44,
          "font": {
            "family": "DM Sans",
            "weight": 700,
            "style": "normal"
          },
          "size": 22,
          "min_size": 14,
          "color": "#111827",
          "hug": true,
          "padding": [
            8,
            16,
            8,
            16
          ],
          "radius": 6,
          "background": {
            "type": "solid",
            "color": "#facc15"
          },
          "transform": "uppercase",
          "letter_spacing": 0.08,
          "balance": false
        },
        {
          "id": "title",
          "name": "Title",
          "type": "text",
          "text": "{title}",
          "x": 72,
          "y": 750,
          "width": 936,
          "height": 260,
          "font": {
            "family": "DM Sans",
            "weight": 700,
            "style": "normal"
          },
          "size": 76,
          "min_size": 32,
          "color": "#ffffff",
          "valign": "bottom",
          "line_height": 1.08,
          "letter_spacing": -0.02,
          "max_lines": 4
        }
      ]
    }
  }
}
