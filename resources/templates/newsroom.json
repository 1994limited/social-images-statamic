{
  "schema": "social-images/1",
  "title": "Newsroom",
  "description": "A red section label, a bold serif headline and the photo alongside. For news and announcements.",
  "layouts": {
    "og": {
      "width": 1200,
      "height": 630,
      "background": {
        "type": "solid",
        "color": "#ffffff"
      },
      "layers": [
        {
          "id": "photo",
          "name": "Photo",
          "type": "image",
          "source": [
            "field:featured_image",
            "field:image",
            "field:hero_image",
            "field:cover_image",
            "field:photo",
            "field:thumbnail"
          ],
          "x": 660,
          "y": 0,
          "width": 540,
          "height": 630,
          "fit": "cover",
          "background": {
            "type": "solid",
            "color": "#e5e7eb"
          }
        },
        {
          "id": "bar",
          "name": "Bar",
          "type": "shape",
          "x": 0,
          "y": 0,
          "width": 12,
          "height": 630,
          "fill": {
            "type": "solid",
            "color": "#dc2626"
          }
        },
        {
          "id": "label",
          "name": "Section",
          "type": "text",
          "text": "{collection:title}",
          "x": 72,
          "y": 64,
          "width": 520,
          "height": 40,
          "font": {
            "family": "Inter",
            "weight": 800,
            "style": "normal"
          },
          "size": 18,
          "min_size": 14,
          "color": "#ffffff",
          "hug": true,
          "background": {
            "type": "solid",
            "color": "#dc2626"
          },
          "padding": [
            7,
            12,
            7,
            12
          ],
          "transform": "uppercase",
          "letter_spacing": 0.1,
          "balance": false
        },
        {
          "id": "title",
          "name": "Headline",
          "type": "text",
          "text": "{title}",
          "x": 72,
          "y": 130,
          "width": 540,
          "height": 340,
          "font": {
            "family": "Playfair Display",
            "weight": 800,
            "style": "normal"
          },
          "size": 64,
          "min_size": 32,
          "color": "#111827",
          "valign": "middle",
          "line_height": 1.08,
          "max_lines": 4
        },
        {
          "id": "rule",
          "name": "Rule",
          "type": "shape",
          "x": 72,
          "y": 500,
